{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "check": {
      "dependsOn": [
        "lint",
        "format",
        "typecheck"
      ]
    },
    "lint": {},
    "format": {},
    "typecheck": {},
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "persistent": true
    }
  }
}